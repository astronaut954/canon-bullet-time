; Windows installer for Stillpoint (Inno Setup 6.5.2 or newer: the wizard images are PNG).
; Built by scripts/build_release.py, which passes:
;   /DAppVersion=2.1.0  /DDistDir=<dist\windows-x64>  /DOutputDir=<release>  /DOutputName=<file name>
; Images: generated by scripts/make_installer_art.py (approved on 2026-10-14).

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef DistDir
  #define DistDir "..\..\dist\windows-x64"
#endif
#ifndef OutputDir
  #define OutputDir "..\..\release"
#endif
#ifndef OutputName
  #define OutputName "stillpoint-setup"
#endif

[Setup]
; AppId identifies the app across versions (a new version installs over the old one). Never change it.
AppId={{DEA184AB-F60A-45A4-A27F-479C8091442F}
AppName=Stillpoint
AppVersion={#AppVersion}
AppVerName=Stillpoint {#AppVersion}
AppPublisher=astronaut954
AppPublisherURL=https://github.com/astronaut954/stillpoint-bullet-time-photography
AppSupportURL=https://github.com/astronaut954/stillpoint-bullet-time-photography/issues
AppUpdatesURL=https://github.com/astronaut954/stillpoint-bullet-time-photography/releases
AppComments=Bullet time photography: fires several cameras at the same instant.
DefaultDirName={autopf}\Stillpoint
DisableProgramGroupPage=yes
DisableWelcomePage=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir={#OutputDir}
OutputBaseFilename={#OutputName}
SetupIconFile=..\icon\app-icon.ico
UninstallDisplayIcon={app}\Stillpoint.exe
UninstallDisplayName=Stillpoint
WizardStyle=modern
WizardImageFile=wizard-image-202x386.png,wizard-image-303x579.png,wizard-image-404x772.png,wizard-image-534x1022.png
WizardSmallImageFile=wizard-small-58.png,wizard-small-87.png,wizard-small-116.png,wizard-small-159.png
Compression=lzma2
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "terminalapp"; Description: "Also install the terminal app (optional)"; GroupDescription: "Optional:"; Flags: unchecked

[Files]
Source: "{#DistDir}\Stillpoint.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#DistDir}\*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#DistDir}\assets\*"; DestDir: "{app}\assets"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#DistDir}\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#DistDir}\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#DistDir}\THIRD_PARTY_NOTICES.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#DistDir}\CDC_EDSDK_Compat_List.pdf"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#DistDir}\Terminal App\*"; DestDir: "{app}\Terminal App"; Flags: ignoreversion recursesubdirs createallsubdirs; Tasks: terminalapp

[Icons]
Name: "{autoprograms}\Stillpoint"; Filename: "{app}\Stillpoint.exe"
Name: "{autodesktop}\Stillpoint"; Filename: "{app}\Stillpoint.exe"; Tasks: desktopicon
Name: "{autoprograms}\Stillpoint Terminal App"; Filename: "{app}\Terminal App\Stillpoint Terminal App.exe"; WorkingDir: "{app}\Terminal App"; Tasks: terminalapp

[Run]
Filename: "{app}\Stillpoint.exe"; Description: "{cm:LaunchProgram,Stillpoint}"; Flags: nowait postinstall skipifsilent
; Update started by the app itself (silent install): open Stillpoint again at the end
Filename: "{app}\Stillpoint.exe"; Flags: nowait runasoriginaluser; Check: WizardSilent

; Photos kept by the app live in %LOCALAPPDATA%\Stillpoint and are not removed on uninstall.
